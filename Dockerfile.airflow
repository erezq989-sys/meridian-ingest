FROM docker:27-cli AS docker_cli

FROM alpine:3.21 AS just_cli
ADD --checksum=sha256:181b91d0ceebe8a57723fb648ed2ce1a44d849438ce2e658339df4f8db5f1263 https://github.com/casey/just/releases/download/1.40.0/just-1.40.0-x86_64-unknown-linux-musl.tar.gz /tmp/just.tar.gz
RUN tar -xzf /tmp/just.tar.gz -C /usr/local/bin just

FROM apache/airflow:3.0.2-python3.11

USER root
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=just_cli /usr/local/bin/just /usr/local/bin/just

USER airflow
COPY --chown=airflow:root pyproject.toml /tmp/meridian/pyproject.toml
COPY --chown=airflow:root src/ /tmp/meridian/src/
RUN pip install --no-cache-dir /tmp/meridian

WORKDIR /opt/meridian
